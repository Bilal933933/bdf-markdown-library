# انسخ هذا الملف إلى .env وأدخل قيمك الحقيقية (لا ترفع .env أبدًا)
GEMINI_API_KEY=your_key_here
# أو عدة مفاتيح مفصولة بفواصل للتدوير التلقائي:
# GEMINI_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK=gemini-3.1-flash-lite,gemini-flash-latest
GEMINI_PROMPT=انسخ محتوى هذه الصفحة نصًا فقط، لا شيء آخر.
PAGES_PER_PART=40
OCR_TIMEOUT_MS=90000
OCR_MAX_RETRIES=20
OCR_PAGE_DELAY_MS=600
