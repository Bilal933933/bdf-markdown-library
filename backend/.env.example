# Foundation فقط — لا تعلن متغيرًا لا يستخدمه الأساس.
# (REDIS_URL / GEMINI_* تأتي مع مراحلها)
APP_NAME=document-conversion-engine
APP_ENV=local
DEBUG=true
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
STORAGE_DIR=storage
# مثال فقط — القيمة الحقيقية في backend/.env المحلي (لا يُدفع أبدًا):
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/dce
# REDIS_URL=redis://localhost:6379/0
