# Foundation فقط — لا تعلن متغيرًا لا يستخدمه الأساس.
# (REDIS_URL / GEMINI_* تأتي مع مراحلها)
APP_NAME=document-conversion-engine
APP_ENV=local
DEBUG=true
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
STORAGE_DIR=storage
MAX_FILE_SIZE=104857600
MAX_PAGES=2000
# OCR (القيم الحقيقية في backend/.env المحلي فقط — لا تُدفع أبدًا):
# GEMINI_KEYS=key1,key2
# GEMINI_API_KEY=key
# GEMINI_MODEL=gemini-3-flash-preview
# API_KEYS=key1,key2 (فارغ = مفتوح للتطوير فقط)
# لاحقة :read للقراءة فقط: API_KEYS=admin-key,reader-key:read
# RATE_LIMIT_PER_MINUTE=60 (صفر يعطل الحد)
# CORS_ORIGINS=https://app.example.com (فارغ = نفس الأصل فقط)
# مثال فقط — القيمة الحقيقية في backend/.env المحلي (لا يُدفع أبدًا):
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/dce
# REDIS_URL=redis://localhost:6379/0
